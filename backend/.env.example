# backend/.env.example
# Configurações do Banco de Dados PostgreSQL (Produção / Staging / Local Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coleta_pneus_db

# Ambiente (development, testing, production)
ENVIRONMENT=development

# Assinatura dos tokens JWT (gerar com: python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=troque-por-um-segredo-aleatorio-de-producao

# Validade do token de acesso (minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=30
