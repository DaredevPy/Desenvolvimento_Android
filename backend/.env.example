# backend/.env.example
# Configurações do Banco de Dados PostgreSQL (Produção / Staging / Local Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coleta_pneus_db

# Ambiente (development, testing, production)
ENVIRONMENT=development

# Assinatura dos tokens JWT (gerar com: python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=troque-por-um-segredo-aleatorio-de-producao

# Validade do token de acesso (minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate limiting por IP com janela deslizante em memória (doc 08 §4.4).
# Limite 0 ou negativo DESATIVA o mecanismo (padrão: desenvolvimento/testes).
# Em produção (Docker/Render) defina limites positivos, ex.:
RATE_LIMIT_LOGIN_MAX=0
RATE_LIMIT_REGISTRO_MAX=0
RATE_LIMIT_JANELA_SEGUNDOS=60

# HSTS somente quando HTTPS é garantido na borda do ambiente (ex.: Render).
HSTS_ENABLED=false
